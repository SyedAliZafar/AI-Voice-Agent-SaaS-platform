# Database
# The team shares ONE Neon Postgres so everyone sees the same calls/prospects/leads.
# Ask a teammate for the real connection string — it is not in git. Paste it below,
# with two edits to what Neon's dashboard shows you, both required:
#   1. postgresql+asyncpg://  (not postgresql://) — this codebase uses the async driver
#   2. ?ssl=require           (not ?sslmode=require) — sslmode is a libpq/psycopg param;
#      asyncpg rejects it with "unexpected keyword argument 'sslmode'"
# Migrations are already applied there; you do NOT need to re-run them for a fresh clone.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?ssl=require

# Prefer a throwaway local database instead of the shared one? Start it explicitly
# (it is behind a profile so it never shadows Neon by accident) and use the URL below:
#   docker compose --profile local-db up -d postgres
#   uv run alembic -c backend/migrations/alembic.ini upgrade head
# DATABASE_URL=postgresql+asyncpg://voiceagent:voiceagent@localhost:5433/voiceagent
# Port 5433, NOT 5432 — docker-compose maps postgres to 5433 on the host to avoid
# colliding with any other Postgres already running locally.

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (ADR-008 — per-agent model selection; see backend/services/llm_service.py's
# MODEL_CATALOG for supported ids). Either key can be left empty if you only use the
# other provider — GET /api/agents/models reports which providers are configured.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-your-openai-key-here
# Model used when an agent's llm_model is unset (""). Must be an id from MODEL_CATALOG
# or resolvable by provider_for's prefix inference (gpt-*/o1*/o3* -> openai, deepseek-* ->
# deepseek).
DEFAULT_LLM_MODEL=deepseek-chat
# Kill switch for the streaming custom-LLM path (backend/api/retell_ws.py, ADR-009).
# false restores the pre-streaming single-frame blocking response behavior.
LLM_STREAMING_ENABLED=true
# How long Retell holds the agent's opener after the call is answered, so the person who
# picked up can say "Hello?" without being talked over (ADR-010). Sent as Retell's
# begin_message_delay_ms at provisioning time; max 5000. Changing it re-provisions the
# Retell agent on the next test call.
GREETING_DELAY_MS=1500

# Voice platforms
RETELL_API_KEY=your-retell-key
VAPI_API_KEY=your-vapi-key
# Set after running scripts/setup_retell_number.py (imports a Twilio number into Retell
# for outbound test calls). Leave empty until then.
RETELL_FROM_NUMBER=
RETELL_DEFAULT_VOICE_ID=11labs-Adrian
# Our own public https URL — required for agents with use_custom_llm=True
# (backend/api/retell_ws.py); Retell dials our websocket at wss://<this host>/llm-websocket.
# Two ways to get one, see RUN.md "Exposing the API publicly":
#   docker compose --profile tunnel up -d        # named tunnel (recommended) — needs
#                                                  # CF_TUNNEL_TOKEN below, but the
#                                                  # hostname is permanent: set this once.
#   docker compose --profile tunnel-quick up -d  # quick tunnel, zero setup, but the
#                                                  # hostname changes every restart AND the
#                                                  # tunnel can silently die mid-session
#                                                  # while still reporting "Up" — see RUN.md.
# If using the quick tunnel, set this to the literal string `auto` and never touch it
# again: the current hostname is then read from cloudflared's own /quicktunnel metrics
# endpoint at use time (backend/services/public_url.py), so a tunnel restart stops being
# a manual edit + container recreate. A literal https:// URL always wins and is what the
# named tunnel and any real deployment should use.
#   PUBLIC_BASE_URL=auto                              # quick tunnel, self-discovering
#   PUBLIC_BASE_URL=https://voiceagent.example.com    # named tunnel / production
PUBLIC_BASE_URL=
# Only consulted when PUBLIC_BASE_URL=auto. The default targets localhost so host-run
# tooling (scripts/check_custom_llm.py) works; docker-compose.yml injects the
# compose-network address into the api and worker containers.
CLOUDFLARED_METRICS_URL=http://localhost:20241
# Token for the named tunnel profile above. One-time setup: `cloudflared tunnel login`,
# `cloudflared tunnel create voiceagent`, `cloudflared tunnel route dns voiceagent
# voiceagent.<your-domain>`, then `cloudflared tunnel token voiceagent` prints this value.
# Needs a domain on a free Cloudflare account. See RUN.md "Named tunnel setup". Leave
# empty if using the quick tunnel instead.
CF_TUNNEL_TOKEN=
# Verify Retell's X-Retell-Signature on /webhooks/retell. Keep true — once a tunnel is
# running, an unverified endpoint lets anyone with the URL forge call events. Retell
# signs with the API key that has the "webhook" badge in their dashboard; if every event
# starts failing verification, check RETELL_API_KEY is that key.
RETELL_VERIFY_WEBHOOKS=true

# Telephony
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
# Elastic SIP Trunk domain for your Twilio number, e.g. "yourtrunk.pstn.twilio.com".
# Create one in Twilio Console → Elastic SIP Trunking → Trunks → Create new Trunk,
# add your number under "Origination", then copy the trunk domain here. Required by
# scripts/setup_retell_number.py to import the number into Retell.
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com
# SIP trunk auth — a username/password YOU create inside that trunk's Credential List
# (Twilio Console → your trunk → Authentication → Credential Lists). NOT your Twilio
# account SID/auth token — those are a different credential type Retell doesn't accept here.
RETELL_SIP_TRUNK_USERNAME=your-sip-trunk-username
RETELL_SIP_TRUNK_PASSWORD=your-sip-trunk-password

# Prospecting — Google Places discovery + website research (see phases/completed/phase2.md)
GOOGLE_PLACES_API_KEY=your-google-places-key

# Storage
S3_BUCKET=voiceagent-recordings
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT_URL=http://localhost:9000

# Auth (backend secret key only — the frontend publishable key goes in
# frontend/.env.local, see frontend/.env.local.example)
CLERK_SECRET_KEY=your-clerk-secret

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production

# Celery (dev-only: set to true to run tasks inline without a separate worker process)
CELERY_TASK_ALWAYS_EAGER=false
