# Database
# Port 5433, NOT 5432 — docker-compose maps postgres to 5433 on the host to avoid
# colliding with any other Postgres already running locally. Inside the compose network
# the api/worker services override this to postgres:5432.
DATABASE_URL=postgresql+asyncpg://voiceagent:voiceagent@localhost:5433/voiceagent

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Voice platforms
RETELL_API_KEY=your-retell-key
VAPI_API_KEY=your-vapi-key
# Set after running scripts/setup_retell_number.py (imports a Twilio number into Retell
# for outbound test calls). Leave empty until then.
RETELL_FROM_NUMBER=
RETELL_DEFAULT_VOICE_ID=11labs-Adrian
# Our own public https URL — the dev tunnel's address (docker compose --profile tunnel
# up; check its logs for the printed https://*.trycloudflare.com URL). Only needed for
# agents with use_custom_llm=True (backend/api/retell_ws.py) — Retell dials our
# websocket at wss://<this host>/llm-websocket. Changes every tunnel restart; update
# this and place a new test call to re-provision (test_call_service.py detects the
# mismatch automatically).
PUBLIC_BASE_URL=
# Verify Retell's X-Retell-Signature on /webhooks/retell. Keep true — once a tunnel is
# running, an unverified endpoint lets anyone with the URL forge call events. Retell
# signs with the API key that has the "webhook" badge in their dashboard; if every event
# starts failing verification, check RETELL_API_KEY is that key.
RETELL_VERIFY_WEBHOOKS=true

# Telephony
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
# Elastic SIP Trunk domain for your Twilio number, e.g. "yourtrunk.pstn.twilio.com".
# Create one in Twilio Console → Elastic SIP Trunking → Trunks → Create new Trunk,
# add your number under "Origination", then copy the trunk domain here. Required by
# scripts/setup_retell_number.py to import the number into Retell.
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com
# SIP trunk auth — a username/password YOU create inside that trunk's Credential List
# (Twilio Console → your trunk → Authentication → Credential Lists). NOT your Twilio
# account SID/auth token — those are a different credential type Retell doesn't accept here.
RETELL_SIP_TRUNK_USERNAME=your-sip-trunk-username
RETELL_SIP_TRUNK_PASSWORD=your-sip-trunk-password

# Prospecting — Google Places discovery + website research (see phase2.md)
GOOGLE_PLACES_API_KEY=your-google-places-key

# Storage
S3_BUCKET=voiceagent-recordings
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT_URL=http://localhost:9000

# Auth (backend secret key only — the frontend publishable key goes in
# frontend/.env.local, see frontend/.env.local.example)
CLERK_SECRET_KEY=your-clerk-secret

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production

# Celery (dev-only: set to true to run tasks inline without a separate worker process)
CELERY_TASK_ALWAYS_EAGER=false
