# Clerk (public — safe to expose in the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# DeepSeek — used ONLY by the server-side Agent Builder route (app/api/strategist).
# Server-side secret: do NOT prefix with NEXT_PUBLIC_ (that would leak it to the browser).
# If unset, the Agent Builder still works via a deterministic template fallback.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
